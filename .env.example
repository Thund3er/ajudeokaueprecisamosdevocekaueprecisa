# Copie para .env (local) ou importe na Netlify em:
# Site configuration → Environment variables → Add a variable → Import from a .env file
# Chave de pagamento da MasterFy: Financeiro → Integrações → Credenciais de API
MASTERFY_API_KEY=
# Segredo do webhook cadastrado no painel da MasterFy (valida o cabeçalho X-Signature)
MASTERFY_WEBHOOK_SECRET=
